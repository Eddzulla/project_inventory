<div class="item">
        <h2><%= item.name %></h2>
        <p><%= item.description %></p>
        <h3><%= item.price %> SEK</h3>
        <p><%= item.stock %> pcs</p>
        <p> <%= item.brand_name %> </p> 
        <p> <%= item.country %> </p>
        <form action="/deleteItem/<%= item.id %>" method="POST">
                <p> <% if(isAdmin) { %>
                        <button type="submit">X</button> 
                <%}  else{ } %>
                </p>
        </form>
</div>
    

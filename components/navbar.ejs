
   <header class="page_header"> 
        <a class="home_btn" href="/"><h1>HOME</h1></a> 
        <div class="header_text">  
            <h1>Welcome to the fighting shop</h1> 
            <p>We have items for the top 3 fighting sports</p>
        </div>
        
        <div class="admin_btns">
            <a class="admin_toggle" href="/toggleAdmin">
               <% if(isAdmin){ %> ADMIN: <br> on <% } else { %> ADMIN:<br> off <% } %>
            </a>
            <div class="crud_btn_container">
            <a class="crud_btn" href="/createItem">
                Create item 
            </a>
             </div>
        </div>
       
  
        <span></span>
    </header>

    
   
    <ul>
        <% categories.forEach(category => {%>
            <li > 
                <a href="/categories/<%=category.id%>">
                    <div class="category">
                    <%= category.name %>
                    </div>
                </a>
            </li>
        <%});%>
    </ul>

    <div class="navbar-separator"></div>

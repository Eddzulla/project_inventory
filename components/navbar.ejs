 <!DOCTYPE html>
 <html lang="en">
 <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/styles.css">
 </head>
 <body>
    
   <header class="page_header"> 
        <a class="home_btn" href="/"><h1>HOME</h1></a>   
        <h1>Welcome to the fighting shop</h1> 
        <span></span>
    </header>
    <p>We have items for the top 3 fighting sports</p>
   
    <ul>
        <% categories.forEach(category => {%>
            <li > 
                <a href="/categories/<%=category.id%>">
                    <div class="category">
                    <%= category.name %>
                    </div>
                </a>
            </li>
        <%});%>
    </ul>

    <div class="navbar-separator"></div>

 </body>
 </html>
 
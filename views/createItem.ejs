<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fighting shop</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

    <%- include('../components/navbar', {categories: categories}); -%>
   <h1>Create new item</h1>

    <form action="/createItem" class="create_item_form" method="post">
        
        <div>
        <label for="name">Product name: </label>
        <input type="text" id="name" name="name" required>
        </div>

        <div>
        <label for="description">Description</label>
        <textarea type="desc" id="description" name="description" required></textarea>
        </div>

        <div>
        <label for="price">Price</label>
        <input type="number" id="price" name="price" required>
        </div>
        
        <div>
        <label for="stock">Stock</label>
        <input type="number" id="stock" name="stock" required>
        </div>

       <fieldset>
            <% categories.forEach(category => { %>
            <label>
                <%= category.name %>
                <input type="checkbox" name="category_id" value="<%= category.id %>">
            </label>
            <% });%>
            </fieldset>
       

        <select name="brand_id" id="brand_id" required>
            <option value="" selected disabled hidden>Choose a brand</option>
            <% brands.forEach(brand => { %>
            <option value="<%=brand.id%>"> <%= brand.name %> </option>
            <% });%>
        </select>

        <button type="submit">Create item</button>

        
        
    </form>

</body>
</html>